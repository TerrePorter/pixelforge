# Laravel scheduler for Pixelforge. Without it, generations whose webhook never arrives
# are never polled. schedule:run starts every minute and runs generations:reconcile every
# 10 seconds within that minute.
#
#   cp deploy/cron/pixelforge /etc/cron.d/pixelforge && chmod 644 /etc/cron.d/pixelforge
#
# The user (www-data here) must be PHP-FPM's user (`user =` in the FPM pool config): apache
# on Amazon Linux / RHEL, even when nginx serves the site. `umask 002` keeps the files it
# creates writable by the shared www-data group.
# Amazon Linux 2023 needs `dnf install -y cronie && systemctl enable --now crond`.
# Files in /etc/cron.d must end with a newline.

* * * * * www-data umask 002 && cd /var/www/pixelforge && php artisan schedule:run >> /dev/null 2>&1
